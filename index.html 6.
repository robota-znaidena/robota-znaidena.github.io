
<!DOCTYPE html>
<html lang="uk">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>РоботаЗнайдена — пошук роботи в Україні</title>

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    background: #f5f7fb;
    color: #202938;
}

header {
    background: white;
    border-bottom: 1px solid #e5e9f0;
    padding: 18px 7%;
}

.header-container {
    max-width: 1200px;
    margin: auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 20px;
}

.logo {
    font-size: 26px;
    font-weight: bold;
    color: #2563eb;
    text-decoration: none;
}

.logo span {
    color: #202938;
}

nav {
    display: flex;
    gap: 25px;
    align-items: center;
}

nav a {
    color: #475569;
    text-decoration: none;
    font-size: 15px;
}

nav a:hover {
    color: #2563eb;
}

.btn {
    background: #2563eb;
    color: white !important;
    padding: 12px 20px;
    border-radius: 9px;
    text-decoration: none;
    font-weight: bold;
    display: inline-block;
    transition: 0.2s;
}

.btn:hover {
    background: #1d4ed8;
    transform: translateY(-1px);
}

.hero {
    background: linear-gradient(135deg, #2563eb, #1e40af);
    padding: 75px 20px;
    text-align: center;
    color: white;
}

.hero h1 {
    font-size: 42px;
    margin-bottom: 18px;
}

.hero p {
    font-size: 18px;
    color: #dbeafe;
    margin-bottom: 35px;
}

.search-box {
    max-width: 900px;
    margin: auto;
    background: white;
    padding: 12px;
    border-radius: 14px;
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
}

.search-box input,
.search-box select {
    flex: 1;
    min-width: 180px;
    border: 1px solid #e2e8f0;
    padding: 15px;
    border-radius: 8px;
    font-size: 15px;
    outline: none;
}

.search-box input:focus,
.search-box select:focus {
    border-color: #2563eb;
}

.search-box button {
    border: none;
    cursor: pointer;
    font-size: 15px;
    padding: 15px 25px;
    border-radius: 8px;
    background: #2563eb;
    color: white;
    font-weight: bold;
}

.search-box button:hover {
    background: #1d4ed8;
}

.container {
    max-width: 1200px;
    margin: auto;
    padding: 50px 20px;
}

.section-title {
    font-size: 28px;
    margin-bottom: 12px;
}

.section-description {
    color: #64748b;
    margin-bottom: 30px;
}

.categories {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 18px;
}

.category {
    background: white;
    border: 1px solid #e5e9f0;
    padding: 25px;
    border-radius: 14px;
    text-decoration: none;
    color: #202938;
    transition: 0.2s;
    cursor: pointer;
}

.category:hover {
    border-color: #2563eb;
    transform: translateY(-3px);
    box-shadow: 0 8px 25px rgba(37, 99, 235, 0.08);
}

.category-icon {
    font-size: 32px;
    margin-bottom: 15px;
}

.category h3 {
    margin-bottom: 8px;
    font-size: 18px;
}

.category p {
    color: #64748b;
    font-size: 14px;
}

.jobs-section {
    background: white;
    border-radius: 16px;
    padding: 35px;
    margin-top: 45px;
    border: 1px solid #e5e9f0;
}

.empty-state {
    text-align: center;
    padding: 55px 20px;
}

.empty-icon {
    font-size: 55px;
    margin-bottom: 20px;
}

.empty-state h3 {
    font-size: 24px;
    margin-bottom: 12px;
}

.empty-state p {
    color: #64748b;
    line-height: 1.6;
    max-width: 550px;
    margin: 0 auto 25px;
}

.employer-section {
    background: #eaf1ff;
    border-radius: 16px;
    padding: 40px;
    margin-top: 45px;
    text-align: center;
}

.employer-section h2 {
    font-size: 28px;
    margin-bottom: 15px;
}

.employer-section p {
    color: #475569;
    margin-bottom: 25px;
    line-height: 1.6;
}

footer {
    background: #111827;
    color: white;
    padding: 40px 7%;
    margin-top: 50px;
}

.footer-container {
    max-width: 1200px;
    margin: auto;
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 30px;
}

footer p {
    color: #9ca3af;
    margin-top: 12px;
}

footer a {
    color: #dbeafe;
    text-decoration: none;
}

.footer-links {
    display: flex;
    gap: 20px;
    flex-wrap: wrap;
}

@media (max-width: 700px) {
    header {
        padding: 15px 5%;
    }

    .header-container {
        flex-direction: column;
    }

    nav {
        flex-wrap: wrap;
        justify-content: center;
    }

    .hero {
        padding: 50px 15px;
    }

    .hero h1 {
        font-size: 30px;
    }

    .hero p {
        font-size: 16px;
    }

    .search-box {
        flex-direction: column;
    }

    .search-box input,
    .search-box select {
        width: 100%;
    }

    .search-box button {
        width: 100%;
    }

    .container {
        padding: 35px 15px;
    }

    .jobs-section {
        padding: 20px;
    }

    .employer-section {
        padding: 30px 20px;
    }

    .footer-container {
        flex-direction: column;
    }
}
</style>
</head>

<body>

<header>
    <div class="header-container">

        <a href="#" class="logo">
            Робота<span>Знайдена</span>
        </a>

        <nav>
            <a href="#jobs">Вакансії</a>
            <a href="#categories">Категорії</a>
            <a href="#employers">Роботодавцям</a>
        </nav>

    </div>
</header>

<section class="hero">

    <h1>Знайди роботу своєї мрії</h1>

    <p>
        Нові можливості для кар'єри починаються тут
    </p>

    <div class="search-box">

        <input
            type="text"
            id="jobSearch"
            placeholder="Посада або ключове слово"
        >

        <select id="citySearch">
            <option value="">Усі міста</option>
            <option>Київ</option>
            <option>Харків</option>
            <option>Полтава</option>
            <option>Львів</option>
            <option>Одеса</option>
            <option>Дніпро</option>
            <option>Запоріжжя</option>
            <option>Черкаси</option>
            <option>Чернігів</option>
            <option>Віддалено</option>
        </select>

        <button onclick="searchJobs()">
            Знайти роботу
        </button>

    </div>

</section>

<main class="container">

    <section id="categories">

        <h2 class="section-title">
            Популярні категорії
        </h2>

        <p class="section-description">
            Обери напрямок, у якому хочеш працювати
        </p>

        <div class="categories">

            <div class="category" onclick="selectCategory('IT')">
                <div class="category-icon">💻</div>
                <h3>IT та технології</h3>
                <p>Програмування, підтримка, дизайн</p>
            </div>

            <div class="category" onclick="selectCategory('Продажі')">
                <div class="category-icon">📈</div>
                <h3>Продажі</h3>
                <p>Менеджери, консультанти</p>
            </div>

            <div class="category" onclick="selectCategory('Маркетинг')">
                <div class="category-icon">📢</div>
                <h3>Маркетинг</h3>
                <p>Реклама, SMM, просування</p>
            </div>

            <div class="category" onclick="selectCategory('Логістика')">
                <div class="category-icon">🚚</div>
                <h3>Логістика</h3>
                <p>Доставка, склад, транспорт</p>
            </div>

            <div class="category" onclick="selectCategory('Обслуговування')">
                <div class="category-icon">👥</div>
                <h3>Обслуговування</h3>
                <p>Кафе, магазини, клієнти</p>
            </div>

            <div class="category" onclick="selectCategory('Віддалена робота')">
                <div class="category-icon">🏠</div>
                <h3>Віддалена робота</h3>
                <p>Робота з будь-якого місця</p>
            </div>

        </div>

    </section>

    <section id="jobs" class="jobs-section">

        <h2 class="section-title">
            Актуальні вакансії
        </h2>

        <p class="section-description">
            Переглядай нові можливості та знаходь роботу
        </p>

        <div class="empty-state">

            <div class="empty-icon">🔎</div>

            <h3 id="emptyTitle">
                Вакансій поки немає
            </h3>

            <p id="emptyDescription">
                Ми працюємо над наповненням сайту реальними пропозиціями.
                Зовсім скоро тут з'являться актуальні вакансії від роботодавців.
            </p>

            <a href="#employers" class="btn">
                Розмістити вакансію
            </a>

        </div>

    </section>

    <section id="employers" class="employer-section">

        <h2>Ви шукаєте працівників?</h2>

        <p>
            Розмістіть вакансію на РоботаЗнайдена та знайдіть
            працівника для своєї компанії.
        </p>

        <a
            class="btn"
            href="mailto:YOUR_EMAIL@gmail.com?subject=Розміщення вакансії на РоботаЗнайдена"
        >
            Розмістити вакансію
        </a>

    </section>

</main>

<footer>

    <div class="footer-container">

        <div>
            <a href="#" class="logo" style="color:white;">
                РоботаЗнайдена
            </a>

            <p>
                Платформа для пошуку роботи в Україні.
            </p>
        </div>

        <div class="footer-links">
            <a href="#jobs">Вакансії</a>
            <a href="#categories">Категорії</a>
            <a href="#employers">Роботодавцям</a>
        </div>

    </div>

</footer>

<script>

function searchJobs() {

    const job = document.getElementById("jobSearch").value;
    const city = document.getElementById("citySearch").value;

    const title = document.getElementById("emptyTitle");
    const description = document.getElementById("emptyDescription");

    if (job || city) {

        title.textContent = "Вакансій за вашим запитом поки немає";

        description.textContent =
            "Ми ще не додали вакансії за цим запитом. " +
            "Спробуйте змінити ключові слова або місто.";

    } else {

        title.textContent = "Вакансій поки немає";

        description.textContent =
            "Ми працюємо над наповненням сайту реальними пропозиціями. " +
            "Зовсім скоро тут з'являться актуальні вакансії від роботодавців.";

    }

    document.getElementById("jobs").scrollIntoView({
        behavior: "smooth"
    });

}

function selectCategory(category) {

    document.getElementById("jobSearch").value = category;

    searchJobs();

}

</script>

</body>
</html>
